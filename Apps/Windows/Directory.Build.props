<Project>
  <PropertyGroup>
    <PHTVRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</PHTVRepositoryRoot>
    <PHTVCoreIncludeDir>$(PHTVRepositoryRoot)\Shared\PHTVCore\Sources\PHTVCoreContracts\include</PHTVCoreIncludeDir>
    <PHTVCoreLibraryDir Condition="'$(PHTVCoreLibraryDir)' == ''">$(PHTVRepositoryRoot)\Shared\PHTVCore\.build\x86_64-unknown-windows-msvc\debug</PHTVCoreLibraryDir>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
